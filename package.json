  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --inspect --logHeapUsage --threads=false",
    "test:e2e": "PUBLIC_DIRECTORY='./test/public' vitest run --config ./vitest.config.e2e.ts",
    "nm": "rm -rf node_modules && yarn start && yarn add sharp --ignore-engines",
    "crud": "plop --experimental-modules --plopfile plop/server/crud/plop/index.mjs"
  },
