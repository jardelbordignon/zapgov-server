@authUrl = {{serverUrl}}/auth
@usersUrl = {{serverUrl}}/users

@accessToken = {{authenticate_user.response.body.accessToken}}
@firstUserId = {{list_users.response.body.$.[0].id}}

@adminUserName = Admin
@adminUserEmail = user-admin@email.com
@adminUserPassword = Pwd@123

@commonUserName = John
@commonUserEmail = john@email.com
@commonUserPassword = Pwd@123


# @name create_admin_user
POST  {{usersUrl}}
Content-Type: application/json

{
  "name": "{{adminUserName}}",
  "email": "{{adminUserEmail}}",
  "password": "{{adminUserPassword}}",
  "roles": ["ADMIN"]
}
###


# @name create_common_user
POST  {{usersUrl}}
Content-Type: application/json

{
  "name": "{{commonUserName}}",
  "email": "{{commonUserEmail}}",
  "password": "{{commonUserPassword}}"
}
###


# autenticado com o usuário ADMIN
# @name authenticate_user
POST  {{authUrl}}
Content-Type: application/json

{
  "email": "{{adminUserEmail}}",
  "password": "{{adminUserPassword}}"
}
###


# autenticado com o usuário comum
# @name authenticate_user
POST  {{authUrl}}
Content-Type: application/json

{
  "email": "{{commonUserEmail}}",
  "password": "{{commonUserPassword}}"
}
###


# buscando os usuário ativos
# @name list_users
GET  {{usersUrl}}
Authorization: Bearer {{accessToken}}
###


# buscando os usuário deletados (query param deleted=true)
# @name list_deleted_users
GET  {{usersUrl}}?deleted=true
Authorization: Bearer {{accessToken}}
###


# buscando um usuário pelo id
# @name show_user
GET  {{usersUrl}}/{{firstUserId}}
Authorization: Bearer {{accessToken}}
###


# editar a própia conta
# @name update_user
PUT  {{usersUrl}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "Updated {{commonUserName}}"
}
###


# editar a própria conta alterando email ou senha (necessário currentPassword)
# @name update_user_including_creadentials
PUT  {{usersUrl}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Updated {{commonUserName}}",
  "email": "updated-{{commonUserEmail}}",
  "password": "{{commonUserPassword}}",
  "currentPassword": "{{commonUserPassword}}"
}
###


# editar a conta de um usuário pelo id
# necessário estar logado como um usuário ADMIN
# @name update_other_user
PUT  {{usersUrl}}/ecc5ee10-51b7-46ea-aaf3-71ee68669b8f
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Updated {{commonUserName}}",
  "email": "updated-{{commonUserEmail}}",
  "password": "updated-{{commonUserPassword}}"
}
###

# recuperando a conta de um usuário deletado
# editar a conta de um usuário pelo id
# necessário estar logado como um usuário ADMIN
# @name update_other_user
PUT  {{usersUrl}}/cf951cf3-8995-4d58-9968-7d69cf505485
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "deleted_at": null
}
###


# deletar a própria consta
# @name delete_user
DELETE  {{usersUrl}}
Authorization: Bearer {{accessToken}}
###


# deletar um usuário pelo id
# necessário estar logado com um usuário ADMIN
# o endpoint espera o id do usuário a ser deletado
# o usuário a ser deletado não pode ser um admin (necessário fazer um udpate antes removendo a role ADMIN)
# para solf delete passar a query param soft=true, sem ela o registro é deletado mesmo do banco
# @name delete_user
DELETE  {{usersUrl}}/cf951cf3-8995-4d58-9968-7d69cf505485
Authorization: Bearer {{accessToken}}
###